# ==============================================================================
# LAUS ECOSYSTEM — TEMPLATE DE CONFIGURAÇÃO DE AMBIENTE (.env.example)
# ==============================================================================

# 1. Modo de Execução do Sistema (shadow | homologation | live)
LAUS_ENVIRONMENT=homologation
LAUS_PROJECT_ROOT=.
# Persistência local do latch; remova o arquivo somente após revisão operacional.
LAUS_KILL_SWITCH_PATH=.laus_state/kill_switch.json

# 2. Pilar 1: Barramento de Eventos (Redis Streams)
REDIS_URL=redis://localhost:6379/0

# 3. Pilar 8: Banco Contábil Relacional (PostgreSQL)
POSTGRES_USER=laus_user
POSTGRES_PASSWORD=replace-with-a-long-random-secret
POSTGRES_DB=laus_db
DATABASE_URL=postgresql://laus_user:replace-with-a-long-random-secret@localhost:5432/laus_db

# 4. Pilar 5: Memória Episódica (Qdrant Vector DB)
QDRANT_HOST=localhost
QDRANT_PORT=6333

# 5. Pilar 4: Telemetria Analítica (PostHog Self-Hosted)
# Console UI local (HTTP Basic; gere credenciais fortes; exponha remotamente apenas atrás de TLS)
LAUS_CONSOLE_USERNAME=
LAUS_CONSOLE_PASSWORD=

POSTHOG_HOST=http://localhost:8000
POSTHOG_ENABLED=false  # Ative explicitamente após configurar um token do projeto.
POSTHOG_API_KEY=

# 6. Provedores de LLM & Cognição
# Google Gemini (SDK Oficial google-genai)
GEMINI_API_KEY=
# Groq (Llama-3 Cloud Inference rápida)
GROQ_API_KEY=
# OpenAI (Opcional para Swarm fallback)
OPENAI_API_KEY=

# 7. Servidores MCP & Versionamento
GITHUB_PERSONAL_ACCESS_TOKEN=

# 8. Pilar 3: Parâmetros do Risk Guardrail
# Limites do ledger paper UTC; volume não representa exposição ou saldo de conta real.
MAX_ORDER_USD=500.00
MAX_SLIPPAGE_PCT=0.50
MAX_DAILY_DRAWDOWN_USD=250.00
MAX_DAILY_PAPER_NOTIONAL_USD=2500.00
CIRCUIT_BREAKER_LATENCY_MS=500.0
